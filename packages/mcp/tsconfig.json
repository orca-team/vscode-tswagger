{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2020",
    "moduleResolution": "nodenext",
    "lib": ["es2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "paths": {
      "@tswagger/cli": ["../cli/src/index.ts"],
      "@tswagger/core": ["../core/src/index.ts"],
      "@tswagger/types": ["../types/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "out-test"]
}
